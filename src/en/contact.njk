---
layout: layouts/base.njk
lang: en
pageKey: contact
permalink: /en/contact/index.html
alternateUrl: /kontakt/
---
<header class="page-hero page-hero--contact"><div class="shell page-hero__grid"><div><p class="eyebrow reveal">Contact</p><h1 class="reveal">Let's build something<br>that <em>makes sense.</em></h1></div><p class="reveal">Tell me briefly what you want to build or improve. I will come back with a concrete response.</p></div></header>
<section class="section contact-section"><div class="shell contact-grid"><aside class="contact-aside reveal"><p class="eyebrow">Start a conversation</p><h2>Let's talk about your project</h2>{% if site.contact.email %}<div class="contact-item"><span>Email</span><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></div>{% endif %}<div class="contact-item"><span>Collaboration</span><strong>Poland / remote</strong></div></aside>
<form class="contact-form reveal" name="contact-en" method="POST" action="/en/contact/?success=true" data-netlify="true" netlify-honeypot="bot-field" data-contact-form><input type="hidden" name="form-name" value="contact-en"><p class="honeypot"><label>Do not fill this field: <input name="bot-field"></label></p><div class="form-status form-status--success" data-form-success hidden tabindex="-1">Thank you — your message has been sent. I will get back to you shortly.</div><div class="form-row"><label>Name <input name="name" type="text" autocomplete="name" required placeholder="Your name"></label><label>Email address <input name="email" type="email" autocomplete="email" required placeholder="you@email.com"></label></div><label>Subject <input name="subject" type="text" required placeholder="How can I help?"></label><label>Message <textarea name="message" rows="7" required minlength="10" placeholder="Tell me a little about your project or challenge…"></textarea></label><label class="consent"><input name="consent" type="checkbox" value="yes" required><span>I agree to the use of the provided data solely for handling this message.</span></label><button class="button button--primary" type="submit">Send message <span aria-hidden="true">↗</span></button><p class="form-note">Your data is not stored in this website's database.</p></form></div></section>
