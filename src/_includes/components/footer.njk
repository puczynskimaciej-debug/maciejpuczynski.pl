<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">MP</span>
        <span class="brand-copy"><strong>{{ site.name }}</strong><small>{{ site.tagline }}</small></span>
      </a>
      <p>Tworzę i usprawniam produkty cyfrowe, które mają konkretny cel.</p>
    </div>
    <div>
      <h2>Nawigacja</h2>
      <a href="/">Strona główna</a>
      <a href="/projekty/">Moje projekty</a>
      <a href="/kontakt/">Kontakt</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {% year %} {{ site.name }}. {{ site.legal }}</span>
    {% if site.privacyUrl %}<a href="{{ site.privacyUrl }}">Polityka prywatności</a>{% endif %}
  </div>
</footer>
