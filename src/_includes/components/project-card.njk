<article class="project-card reveal" data-tilt>
  {% set cardTitle = project.data.titleEn if lang == "en" else project.data.title %}
  {% set cardSummary = project.data.summaryEn if lang == "en" else project.data.summary %}
  {% set cardCategory = project.data.categoryEn if lang == "en" else project.data.category %}
  {% set cardUrl = ("/en/projects/" + project.data.slug + "/") if lang == "en" else project.url %}
  <a class="project-card__media" href="{{ cardUrl }}" aria-label="{% if lang == 'en' %}View project{% else %}Zobacz projekt{% endif %} {{ cardTitle }}">
    <img src="{{ project.data.image }}" alt="{{ project.data.imageAlt }}" loading="lazy" width="960" height="640">
    {% if project.data.inProgress %}<span class="status"><i></i> {% if lang == "en" %}In progress{% else %}W trakcie{% endif %}</span>{% endif %}
  </a>
  <div class="project-card__body">
    <div class="project-card__meta">
      <span>{{ cardCategory }}</span>
      <span>0{{ project.data.order }}</span>
    </div>
    <h3><a href="{{ cardUrl }}">{{ cardTitle }}</a></h3>
    <p>{{ cardSummary }}</p>
    {% if project.data.technologies.length %}
    <ul class="tech-list" aria-label="Technologie">
      {% for technology in project.data.technologies %}<li>{{ technology }}</li>{% endfor %}
    </ul>
    {% endif %}
    <a class="arrow-link" href="{{ cardUrl }}">{% if lang == "en" %}View details{% else %}Zobacz szczegóły{% endif %} <span aria-hidden="true">↗</span></a>
  </div>
</article>
